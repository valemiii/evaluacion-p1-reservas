      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Crear horario devuelve 201', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('testScheduleId', String(pm.response.json().id));"
      ] } }]
    },
    {
      "name": "04 - Listar reservas ADMIN (200, IDs dinámicos)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/api/admin/bookings"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Listar reservas devuelve 200', () => pm.response.to.have.status(200));",
        "const rows = pm.response.json();",
        "const userId = Number(pm.collectionVariables.get('userId'));",
        "const owned = rows.find(row => row.userId === userId);",
        "pm.test('La respuesta incluye horario y no contraseña', () => pm.expect(rows.every(row => row.schedule && row.user && !('password' in row.user))).to.eql(true));",
        "if (owned) { pm.collectionVariables.set('seedUserBookingId', String(owned.id)); pm.collectionVariables.set('seedScheduleId', String(owned.scheduleId)); }",
        "const maxId = rows.reduce((max, row) => Math.max(max, row.id), 0);",
        "pm.collectionVariables.set('missingBookingId', String(maxId + 10000));"
      ] } }]
    },
    {
      "name": "05 - Crear reserva USER (201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{userToken}}" },
          { "key": "Content-Type", "value": "application/json" }
