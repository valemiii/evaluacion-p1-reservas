        "body": { "mode": "raw", "raw": "{\"date\":\"{{testBookingDate}}\",\"scheduleId\":{{testScheduleId}}}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/bookings"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Crear reserva devuelve 201', () => pm.response.to.have.status(201));",
        "const booking = pm.response.json();",
        "pm.collectionVariables.set('userBookingId', String(booking.id));",
        "pm.test('El propietario sale del token y no se expone password', () => { pm.expect(booking.userId).to.eql(Number(pm.collectionVariables.get('userId'))); pm.expect(booking.user).not.to.have.property('password'); });"
      ] } }]
    },
